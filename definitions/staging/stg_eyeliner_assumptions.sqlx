config {
  type: "table",
  name: "stg_eyeliner_assumptions",
  schema: "eyeliner",
  tags: ["staging"],
  // Sheet-backed source: force the external table DDL to run first.
  dependencies: ["external_tables"],
  assertions: {
    nonNull: [
      "health_dalys_per_bll",
      "iq_points_lost_per_bll",
      "iq_points_lost_per_bll_neonatal"
    ]
  }
}

-- income_loss_percentage_per_iq_point, daly_to_income_factor, and number_of_years_spent_working
-- are the same as paint and are pulled from stg_assumptions instead of duplicated here.
SELECT
  health_dalys_per_bll,
  iq_points_lost_per_bll,
  iq_points_lost_per_bll_neonatal
FROM
  ${ref("eyeliner_assumptions")}
