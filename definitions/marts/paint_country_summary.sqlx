config {
  type: "table",
  name: "paint_summary_by_country",
  description: "Final DALY impact estimates per country for LEEP paint programs. Two impact scenarios: potential (full program success from baseline) and to_date (actual market reduction as of date_of_volume). The to_date impact is also broken down by manufacturer milestone: the headline to_date figure credits only reformulated manufacturers, while the _taking_steps and _significant_progress columns are cumulative pipeline scenarios crediting manufacturers at those earlier milestones as if they had also removed lead. Applies health/income DALY calculations, time discounting, and probability weighting.",
  tags: ["marts"],
  assertions: {
    uniqueKey: ["country_code"],
    nonNull: ["country_code", "country_name", "tier"],
    rowConditions: [
      "potential_dalys_discounted >= 0",
      "to_date_dalys_discounted >= 0",
      "to_date_dalys_discounted_significant_progress >= 0",
      "to_date_dalys_discounted_taking_steps >= 0",
      // Milestones are cumulative, so each earlier stage must be at least the later one
      "to_date_dalys_discounted_significant_progress >= to_date_dalys_discounted",
      "to_date_dalys_discounted_taking_steps >= to_date_dalys_discounted_significant_progress",
      "tier IN ('A+', 'A', 'B', 'C', 'D')"
    ]
  }
}

WITH base AS (
  SELECT * FROM ${ref("int_paint_program_base")}
),

-- Step 1: compute health and income DALY components separately for each scenario
daly_components AS (
  SELECT
    *,
    health_dalys_per_bll * cbll_averted_potential
      AS potential_health_dalys,
    (income_loss_percentage_per_iq_point
      * iq_points_lost_per_bll
      * cbll_averted_potential
      * number_of_years_spent_working
      * daly_to_income_factor)
      AS potential_income_dalys,
    health_dalys_per_bll * cbll_averted_to_date
      AS to_date_health_dalys,
    (income_loss_percentage_per_iq_point
      * iq_points_lost_per_bll
      * cbll_averted_to_date
      * number_of_years_spent_working
      * daly_to_income_factor)
      AS to_date_income_dalys,
    -- Same components under each manufacturer-milestone pipeline scenario
    health_dalys_per_bll * cbll_averted_to_date_taking_steps
      AS to_date_health_dalys_taking_steps,
    (income_loss_percentage_per_iq_point
      * iq_points_lost_per_bll
      * cbll_averted_to_date_taking_steps
      * number_of_years_spent_working
      * daly_to_income_factor)
      AS to_date_income_dalys_taking_steps,
    health_dalys_per_bll * cbll_averted_to_date_significant_progress
      AS to_date_health_dalys_significant_progress,
    (income_loss_percentage_per_iq_point
      * iq_points_lost_per_bll
      * cbll_averted_to_date_significant_progress
      * number_of_years_spent_working
      * daly_to_income_factor)
      AS to_date_income_dalys_significant_progress
  FROM base
),

-- Step 2: combine components into undiscounted and time-discounted totals
daly_totals AS (
  SELECT
    *,
    potential_health_dalys + potential_income_dalys
      AS potential_dalys_averted,
    potential_health_dalys * health_dalys_discount_rate
      + potential_income_dalys * income_dalys_discount_rate
      AS potential_dalys_discounted,
    to_date_health_dalys + to_date_income_dalys
      AS to_date_dalys_averted,
    to_date_health_dalys * health_dalys_discount_rate
      + to_date_income_dalys * income_dalys_discount_rate
      AS to_date_dalys_discounted,
    to_date_health_dalys_taking_steps * health_dalys_discount_rate
      + to_date_income_dalys_taking_steps * income_dalys_discount_rate
      AS to_date_dalys_discounted_taking_steps,
    to_date_health_dalys_significant_progress * health_dalys_discount_rate
      + to_date_income_dalys_significant_progress * income_dalys_discount_rate
      AS to_date_dalys_discounted_significant_progress
  FROM daly_components
),

-- Step 2b: apply probability weighting on top of time discounting (used for tiering)
daly_probability_weighted AS (
  SELECT
    *,
    potential_dalys_discounted * program_success_probability AS potential_dalys_discounted_probability,
    to_date_dalys_discounted * program_success_probability   AS to_date_dalys_discounted_probability
  FROM daly_totals
)

-- Step 3: assign tiers off time-and-probability discounted DALYs, and select final columns
SELECT
  country_name,
  country_code,
  income_group,
  program,
  status,
  source_of_funding,
  annual_number_of_births,
  urban_rate,
  baseline_lead_paint_market_share,
  current_lead_paint_market_share,
  market_share_year_month,
  market_shift_year,
  market_shift_counterfactual_year,
  lead_paint_reduction_percentage,
  potential_market_share_reduction,
  to_date_market_share_reduction,
  children_born_in_painted_homes,
  children_born_in_lead_painted_homes,
  cbll_averted_potential,
  cbll_averted_to_date,

  -- Tiers based on time-and-probability discounted DALYs (potential scenario)
  CASE
    WHEN potential_dalys_discounted_probability > 100000 THEN 'A+'
    WHEN potential_dalys_discounted_probability >= 50000 THEN 'A'
    WHEN potential_dalys_discounted_probability >= 20000 THEN 'B'
    WHEN potential_dalys_discounted_probability >= 5000  THEN 'C'
    ELSE 'D'
  END AS tier,

  -- ── POTENTIAL IMPACT ───────────────────────────────────────────────────────
  potential_health_dalys                                    AS potential_health_dalys_averted,
  potential_income_dalys                                    AS potential_daly_equivalent_income_loss,
  potential_dalys_averted,
  potential_dalys_discounted,
  potential_dalys_discounted_probability,

  -- ── TO-DATE IMPACT ─────────────────────────────────────────────────────────
  to_date_health_dalys                                      AS to_date_health_dalys_averted,
  to_date_income_dalys                                      AS to_date_daly_equivalent_income_loss,
  to_date_dalys_averted,
  to_date_dalys_discounted,
  to_date_dalys_discounted * program_success_probability    AS to_date_dalys_discounted_probability,

  -- ── TO-DATE IMPACT BY MANUFACTURER MILESTONE ───────────────────────────────
  -- Cumulative pipeline scenarios: what the to-date discounted DALY impact would be if
  -- every manufacturer that has reached this milestone (or a later one) had removed lead.
  -- By construction taking_steps >= significant_progress >= to_date_dalys_discounted.
  to_date_dalys_discounted_taking_steps,
  to_date_dalys_discounted_significant_progress
  to_date_dalys_discounted_probability

FROM daly_probability_weighted
