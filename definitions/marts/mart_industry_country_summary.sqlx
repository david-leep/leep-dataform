config {
  type: "table",
  name: "mart_industry_country_summary",
  description: "Summary statistics on paint manufacturers per country. Counts manufacturers at each engagement milestone and sums their high-Pb and total paint volumes. Excludes placeholder manufacturer IDs ending in 001, 002, or 003.",
  tags: ["marts"],
  assertions: {
    uniqueKey: ["country_code"],
    nonNull: ["country_code"],
    rowConditions: ["high_pb_volume_total <= total_volume_total"]
  }
}

WITH filtered AS (
  SELECT
    SPLIT(unique_id, '-')[OFFSET(0)] AS country_code,
    high_pb_l,
    total_volume_l,
    date_engaged,
    date_taking_steps,
    date_making_significant_progress,
    date_reformulation_complete,
    date_of_repeat_paint_study_showing_lead_free
  FROM ${ref("int_industry_full")}
  WHERE partition_date = DATE_TRUNC(CURRENT_DATE(), MONTH)
    AND NOT REGEXP_CONTAINS(unique_id, r'00[123]$')
),

aggregated AS (
  SELECT
    country_code,

    -- Manufacturer counts
    COUNT(*) AS total_manufacturers,
    COUNTIF(date_engaged <= CURRENT_DATE()) AS manufacturers_engaged,
    COUNTIF(date_taking_steps <= CURRENT_DATE()) AS manufacturers_taking_steps,
    COUNTIF(date_making_significant_progress <= CURRENT_DATE()) AS manufacturers_making_significant_progress,
    COUNTIF(date_reformulation_complete <= CURRENT_DATE()) AS manufacturers_reformulated,
    COUNTIF(date_of_repeat_paint_study_showing_lead_free <= CURRENT_DATE()) AS manufacturers_repeat_study_lead_free,

    -- High-Pb volume by milestone
    SUM(high_pb_l) AS high_pb_volume_total,
    SUM(IF(date_engaged <= CURRENT_DATE(), high_pb_l, 0)) AS high_pb_volume_engaged,
    SUM(IF(date_taking_steps <= CURRENT_DATE(), high_pb_l, 0)) AS high_pb_volume_taking_steps,
    SUM(IF(date_making_significant_progress <= CURRENT_DATE(), high_pb_l, 0)) AS high_pb_volume_making_significant_progress,
    SUM(IF(date_reformulation_complete <= CURRENT_DATE(), high_pb_l, 0)) AS high_pb_volume_reformulated,
    SUM(IF(date_of_repeat_paint_study_showing_lead_free <= CURRENT_DATE(), high_pb_l, 0)) AS high_pb_volume_repeat_study_lead_free,

    -- Total volume by milestone
    SUM(total_volume_l) AS total_volume_total,
    SUM(IF(date_engaged <= CURRENT_DATE(), total_volume_l, 0)) AS total_volume_engaged,
    SUM(IF(date_taking_steps <= CURRENT_DATE(), total_volume_l, 0)) AS total_volume_taking_steps,
    SUM(IF(date_making_significant_progress <= CURRENT_DATE(), total_volume_l, 0)) AS total_volume_making_significant_progress,
    SUM(IF(date_reformulation_complete <= CURRENT_DATE(), total_volume_l, 0)) AS total_volume_reformulated,
    SUM(IF(date_of_repeat_paint_study_showing_lead_free <= CURRENT_DATE(), total_volume_l, 0)) AS total_volume_repeat_study_lead_free

  FROM filtered
  GROUP BY country_code
)

SELECT
  a.country_code,
  cp.country_name,

  a.total_manufacturers,
  a.manufacturers_engaged,
  a.manufacturers_taking_steps,
  a.manufacturers_making_significant_progress,
  a.manufacturers_reformulated,
  a.manufacturers_repeat_study_lead_free,

  a.high_pb_volume_total,
  a.high_pb_volume_engaged,
  a.high_pb_volume_taking_steps,
  a.high_pb_volume_making_significant_progress,
  a.high_pb_volume_reformulated,
  a.high_pb_volume_repeat_study_lead_free,

  a.total_volume_total,
  a.total_volume_engaged,
  a.total_volume_taking_steps,
  a.total_volume_making_significant_progress,
  a.total_volume_reformulated,
  a.total_volume_repeat_study_lead_free

FROM aggregated a
LEFT JOIN ${ref("int_country_profile")} cp
  ON a.country_code = cp.country_code
ORDER BY a.country_code
