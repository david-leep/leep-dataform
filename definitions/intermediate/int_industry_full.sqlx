config {
  type: "incremental",
  name: "int_industry_full",
  tags: ["intermediate"],
  bigquery: {
    partitionBy: "partition_date"
  }
}

pre_operations {
  DELETE FROM ${self()} WHERE partition_date = DATE_TRUNC(CURRENT_DATE(), MONTH)
}

SELECT
  *,
  DATE_TRUNC(CURRENT_DATE(), MONTH) AS partition_date
FROM ${ref("stg_industry_full")}
WHERE unique_id IS NOT NULL
  AND NOT STARTS_WITH(unique_id, '#')