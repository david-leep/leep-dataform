config {
  type: "table",
  name: "int_lead_paint_market_share",
  tags: ["intermediate"],
  assertions: {
    uniqueKey: ["country_code", "year_month"],
    nonNull: ["country_code", "year_month"]
  }
}

WITH base AS (
  SELECT
    SUBSTR(unique_id, 1, 3) AS country_code,
    unique_id,
    total_volume_l,
    leaded_paint_type,
    high_pb_l,
    oil_l,
    date_reformulation_complete,
    -- Milestone flags are cumulative: a manufacturer that reached a later milestone
    -- counts as having reached the earlier ones, even if the earlier date is blank.
    (date_taking_steps IS NOT NULL
      OR date_making_significant_progress IS NOT NULL
      OR date_reformulation_complete IS NOT NULL)    AS reached_taking_steps,
    (date_making_significant_progress IS NOT NULL
      OR date_reformulation_complete IS NOT NULL)    AS reached_significant_progress,
    FORMAT_DATE('%Y-%m', partition_date) AS year_month
  FROM ${ref("int_industry_full")}
  WHERE total_volume_l IS NOT NULL
),

manufacturer_stats AS (
  SELECT
    country_code,
    year_month,
    unique_id,
    total_volume_l,
    leaded_paint_type,
    high_pb_l,
    oil_l,
    date_reformulation_complete,
    reached_taking_steps,
    reached_significant_progress,
    MAX(CASE WHEN leaded_paint_type LIKE '%Water%' THEN 1 ELSE 0 END) OVER (PARTITION BY country_code, year_month) AS country_has_water,
    SUM(total_volume_l) OVER (PARTITION BY country_code, year_month) AS country_total_volume
  FROM base
),

market_share AS (
  SELECT
    country_code,
    year_month,
    country_total_volume,
    country_has_water,
    -- Baseline: calculates the baseline lead paint market share based on most recent industry tracker data
    CASE
      WHEN country_has_water = 1 THEN
        SUM(CASE WHEN high_pb_l > 0 THEN total_volume_l / NULLIF(country_total_volume, 0) ELSE 0 END)
      ELSE
        SAFE_DIVIDE(SUM(high_pb_l), SUM(oil_l))
    END AS baseline_lead_paint_market_share,
    -- Current: excludes manufacturers who have completed reformulation
    CASE
      WHEN country_has_water = 1 THEN
        SUM(CASE WHEN high_pb_l > 0 AND date_reformulation_complete IS NULL THEN total_volume_l / NULLIF(country_total_volume, 0) ELSE 0 END)
      ELSE
        SAFE_DIVIDE(
          SUM(CASE WHEN date_reformulation_complete IS NULL THEN high_pb_l ELSE 0 END),
          SUM(oil_l)
        )
    END AS current_lead_paint_market_share,
    -- Pipeline scenarios: same calculation, but crediting manufacturers at an earlier
    -- milestone as if they had also removed lead. Used to show what to-date impact is in
    -- the pipeline behind the reformulated figure. Cumulative, so these are always
    -- lower (more optimistic) than current_lead_paint_market_share.
    CASE
      WHEN country_has_water = 1 THEN
        SUM(CASE WHEN high_pb_l > 0 AND NOT reached_taking_steps THEN total_volume_l / NULLIF(country_total_volume, 0) ELSE 0 END)
      ELSE
        SAFE_DIVIDE(
          SUM(CASE WHEN NOT reached_taking_steps THEN high_pb_l ELSE 0 END),
          SUM(oil_l)
        )
    END AS current_lead_paint_market_share_taking_steps,
    CASE
      WHEN country_has_water = 1 THEN
        SUM(CASE WHEN high_pb_l > 0 AND NOT reached_significant_progress THEN total_volume_l / NULLIF(country_total_volume, 0) ELSE 0 END)
      ELSE
        SAFE_DIVIDE(
          SUM(CASE WHEN NOT reached_significant_progress THEN high_pb_l ELSE 0 END),
          SUM(oil_l)
        )
    END AS current_lead_paint_market_share_significant_progress
  FROM manufacturer_stats
  GROUP BY country_code, year_month, country_has_water, country_total_volume
),

country_map AS (
  SELECT country_code, country_name
  FROM ${ref("int_country_profile")}
)

SELECT
  ms.country_code,
  ms.year_month,
  ms.country_total_volume,
  ms.country_has_water,
  ms.baseline_lead_paint_market_share,
  ms.current_lead_paint_market_share,
  ms.current_lead_paint_market_share_taking_steps,
  ms.current_lead_paint_market_share_significant_progress,
  cf.program,
  cf.status,
  cf.source_of_funding
FROM market_share ms
LEFT JOIN country_map cm ON ms.country_code = cm.country_code
LEFT JOIN ${ref("stg_counterfactual")} cf ON cm.country_code = cf.country_code